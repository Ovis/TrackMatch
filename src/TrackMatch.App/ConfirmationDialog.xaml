<Window x:Class="TrackMatch.App.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="確認"
        Width="480"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!--
            標準Button Templateはhover時にOS Theme側の白背景へ戻る場合がある。
            Dialogの主操作は常にAccent系の色を維持し、活性な主要操作であることを視覚的に保つ。
        -->
        <Style x:Key="DialogPrimaryButtonStyle"
               BasedOn="{StaticResource PrimaryButtonStyle}"
               TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16"
            Padding="20"
            Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBackground"
                        Width="38"
                        Height="38"
                        VerticalAlignment="Top"
                        Background="#FFF4CE"
                        CornerRadius="19">
                    <TextBlock x:Name="IconTextBlock"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#8A5A00"
                               Text="!" />
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="HeadingTextBlock"
                               Style="{StaticResource SectionTitleStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageTextBlock"
                               Margin="0,8,0,0"
                               LineHeight="20"
                               Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="TertiaryButton"
                        MinWidth="92"
                        Click="Tertiary_Click"
                        Visibility="Collapsed" />
                <Button x:Name="SecondaryButton"
                        MinWidth="92"
                        Margin="8,0,0,0"
                        Click="Secondary_Click"
                        Visibility="Collapsed" />
                <Button x:Name="PrimaryButton"
                        MinWidth="92"
                        Margin="8,0,0,0"
                        Click="Primary_Click"
                        Content="続行"
                        IsDefault="True"
                        Style="{StaticResource DialogPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
