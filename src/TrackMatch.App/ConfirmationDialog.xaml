<Window x:Class="TrackMatch.App.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="確認"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Margin="16" Style="{StaticResource CardStyle}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBackground"
                        Width="38" Height="38"
                        VerticalAlignment="Top"
                        Background="#FFF4CE"
                        CornerRadius="19">
                    <TextBlock x:Name="IconTextBlock"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#8A5A00"
                               Text="!"/>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="HeadingTextBlock"
                               Style="{StaticResource SectionTitleStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageTextBlock"
                               Margin="0,8,0,0"
                               Style="{StaticResource SecondaryTextStyle}"
                               LineHeight="20"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="TertiaryButton"
                        MinWidth="92"
                        Visibility="Collapsed"
                        Click="Tertiary_Click"/>
                <Button x:Name="SecondaryButton"
                        MinWidth="92"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        Click="Secondary_Click"/>
                <Button x:Name="PrimaryButton"
                        MinWidth="92"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="続行"
                        IsDefault="True"
                        Click="Primary_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
