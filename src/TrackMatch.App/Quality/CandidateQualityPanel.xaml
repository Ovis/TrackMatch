<UserControl x:Class="TrackMatch.App.Quality.CandidateQualityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="CandidateQualityPanel_Loaded">
    <GroupBox Padding="10"
              Header="音質比較">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding QualityStatusText}" />
                <Button Grid.Column="2"
                        Padding="12,4"
                        Click="Reanalyze_Click"
                        Content="音質を再解析"
                        IsEnabled="{Binding CanReanalyzeQuality}" />
            </Grid>

            <ScrollViewer x:Name="QualityScrollViewer"
                          Grid.Row="2"
                          CanContentScroll="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <Border Padding="10"
                            BorderBrush="#D8D8D8"
                            BorderThickness="1"
                            CornerRadius="3">
                        <StackPanel>
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding QualitySummaryLine1}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding QualitySummaryLine2}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding QualitySummaryLine3}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ItemsControl Margin="0,8,0,0"
                                  ItemsSource="{Binding QualityFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Severity}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,10,0,4"
                               FontWeight="SemiBold"
                               Text="詳細な測定値" />
                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              HorizontalScrollBarVisibility="Disabled"
                              IsReadOnly="True"
                              ItemsSource="{Binding QualityMeasurements}"
                              PreviewMouseWheel="QualityMeasurements_PreviewMouseWheel"
                              RowHeaderWidth="0"
                              VerticalScrollBarVisibility="Disabled">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Description}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"
                                                MinWidth="180"
                                                Binding="{Binding Label}"
                                                Header="項目" />
                            <DataGridTextColumn Width="110"
                                                Binding="{Binding ValueA}"
                                                Header="A" />
                            <DataGridTextColumn Width="110"
                                                Binding="{Binding ValueB}"
                                                Header="B" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </GroupBox>
</UserControl>
