<Window x:Class="TrackMatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:playback="clr-namespace:TrackMatch.App.Playback"
        Title="TrackMatch" Height="1040" Width="1480" MinHeight="860" MinWidth="1180">
    <Window.Resources>
        <playback:PlaybackModeLabelConverter x:Key="PlaybackModeLabelConverter"/>
        <playback:RelativeOffsetConverter x:Key="RelativeOffsetConverter"/>
        <playback:PlaybackStatusIconConverter x:Key="PlaybackStatusIconConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="250"/><ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="ライブラリ"/>
            <ComboBox x:Name="LibraryComboBox" Grid.Column="2" ItemsSource="{Binding Libraries}" SelectedItem="{Binding SelectedLibrary}"
                      DisplayMemberPath="Name" SelectionChanged="LibraryComboBox_SelectionChanged"/>
            <Button Grid.Column="4" Content="⚙  管理..." IsEnabled="{Binding CanManageLibraries}" Click="ManageLibraries_Click"/>
            <Button Grid.Column="6" Style="{StaticResource PrimaryButtonStyle}" Content="⌕  スキャン・分析" IsEnabled="{Binding CanAnalyzeLibrary}" Click="AnalyzeLibrary_Click"/>
            <Button Grid.Column="8" Content="■  キャンセル" IsEnabled="{Binding CanCancelAnalysis}" Click="CancelAnalysis_Click"/>
            <Button Grid.Column="10" Content="ごみ箱へ移動" IsEnabled="{Binding CanProcessTrash}" Click="ExecuteTrash_Click"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Margin="12,12,12,6" Style="{StaticResource SectionTitleStyle}" Text="候補一覧"/>
                    <TabControl x:Name="CandidateTabs" Grid.Row="1" Margin="8,0,8,0" Height="40" SelectionChanged="CandidateTabs_SelectionChanged">
                        <TabItem><TabItem.Header><TextBlock><Run Text="未レビュー ("/><Run Text="{Binding UnreviewedCount, Mode=OneWay}"/><Run Text=")"/></TextBlock></TabItem.Header></TabItem>
                        <TabItem><TabItem.Header><TextBlock><Run Text="レビュー済み ("/><Run Text="{Binding ReviewedCount, Mode=OneWay}"/><Run Text=")"/></TextBlock></TabItem.Header></TabItem>
                        <TabItem><TabItem.Header><TextBlock><Run Text="すべて ("/><Run Text="{Binding TotalCandidateCount, Mode=OneWay}"/><Run Text=")"/></TextBlock></TabItem.Header></TabItem>
                    </TabControl>
                    <Grid Grid.Row="2" Margin="12,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Text="レビュー対象の一致度下限" Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBox Grid.Column="1" Width="48" HorizontalContentAlignment="Right" Text="{Binding SimilarityDisplayLowerBoundPercent, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="%"/>
                    </Grid>
                    <Grid Grid.Row="3">
                        <DataGrid x:Name="CandidateGrid" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="分類" Binding="{Binding Kind}" Width="120"/>
                                <DataGridTextColumn Header="A" Binding="{Binding TitleA}" Width="*"/>
                                <DataGridTextColumn Header="B" Binding="{Binding TitleB}" Width="*"/>
                                <DataGridTextColumn Header="音響一致度" Binding="{Binding Similarity}" Width="90"/>
                                <DataGridTextColumn Header="レビュー結果" Binding="{Binding ReviewResult}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- DataGrid内部では列ヘッダーと縦ScrollBarの交差部分が空セルになるため、候補一覧だけ同色で覆う。 -->
                        <Border x:Name="CandidateGridHeaderCornerOverlay" Width="14" Height="30" Margin="0,1,1,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#F3F6F9" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2" DataContext="{Binding SelectedCandidate}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/><RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <GroupBox Header="音源 A" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding TitleA}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding ArtistA}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" Text="{Binding AlbumA}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" Text="{Binding GenreA}" TextWrapping="Wrap"/>
                            <Separator Margin="0,8"/>
                            <TextBlock Text="{Binding DurationA, StringFormat=再生時間: {0}}"/>
                            <TextBlock Text="{Binding FormatCodecA, StringFormat=形式 / コーデック: {0}}"/>
                            <TextBlock Text="{Binding FileSizeA, StringFormat=ファイルサイズ: {0}}"/>
                            <TextBlock Text="{Binding BitrateA, StringFormat=ビットレート: {0}}"/>
                            <TextBlock Text="{Binding SampleRateA, StringFormat=サンプルレート: {0}}"/>
                            <TextBlock Text="{Binding BitDepthA, StringFormat=ビット深度: {0}}"/>
                            <TextBlock Text="{Binding ChannelsA, StringFormat=チャンネル数: {0}}"/>
                            <TextBlock Margin="0,8,0,0" Text="{Binding Row.PathA}" TextWrapping="Wrap" Opacity="0.7"/>
                        </StackPanel></ScrollViewer>
                    </GroupBox>
                    <GroupBox Grid.Column="2" Header="音源 B" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding TitleB}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding ArtistB}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" Text="{Binding AlbumB}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" Text="{Binding GenreB}" TextWrapping="Wrap"/>
                            <Separator Margin="0,8"/>
                            <TextBlock Text="{Binding DurationB, StringFormat=再生時間: {0}}"/>
                            <TextBlock Text="{Binding FormatCodecB, StringFormat=形式 / コーデック: {0}}"/>
                            <TextBlock Text="{Binding FileSizeB, StringFormat=ファイルサイズ: {0}}"/>
                            <TextBlock Text="{Binding BitrateB, StringFormat=ビットレート: {0}}"/>
                            <TextBlock Text="{Binding SampleRateB, StringFormat=サンプルレート: {0}}"/>
                            <TextBlock Text="{Binding BitDepthB, StringFormat=ビット深度: {0}}"/>
                            <TextBlock Text="{Binding ChannelsB, StringFormat=チャンネル数: {0}}"/>
                            <TextBlock Margin="0,8,0,0" Text="{Binding Row.PathB}" TextWrapping="Wrap" Opacity="0.7"/>
                        </StackPanel></ScrollViewer>
                    </GroupBox>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <GroupBox Header="比較結果" Padding="10">
                        <StackPanel>
                            <Border Padding="12,10" Background="#F3F7FB" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="音響一致度"/>
                                    <TextBlock Grid.Column="1" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Similarity}"/>
                                </Grid>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Aの一致範囲"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding CoverageA}"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource SecondaryTextStyle}" Text="Bの一致範囲"/><TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="{Binding CoverageB}"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="再生時間の近さ"/><TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{Binding DurationRatio}"/>
                                <TextBlock Grid.Row="3" Style="{StaticResource SecondaryTextStyle}" Text="最適オフセット"/><TextBlock Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" Text="{Binding BestOffset}"/>
                                <TextBlock Grid.Row="4" Style="{StaticResource SecondaryTextStyle}" Text="一致区間の長さ"/><TextBlock Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Text="{Binding MatchedDuration}"/>
                            </Grid>
                            <Border Margin="0,10,0,0" Padding="10,8" Background="#F7F8FA" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="判定理由"/>
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Reason}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="2" Header="音質比較" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{Binding QualityStatusText}"/>
                                <Button Grid.Column="1" Content="音質を再解析" IsEnabled="{Binding CanReanalyzeQuality}" Click="ReanalyzeQuality_Click"/>
                            </Grid>
                            <ContentControl Grid.Row="2" Content="{Binding QualityPanel}"/>
                        </Grid>
                    </GroupBox>
                </Grid>

                <GroupBox Grid.Row="4" Header="A/B 同期再生" Padding="10" DataContext="{Binding DataContext.Playback, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid IsEnabled="{Binding CanControl}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Slider x:Name="PlaybackSeekSlider" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                                    PreviewMouseLeftButtonUp="PlaybackSeekSlider_PreviewMouseLeftButtonUp" KeyUp="PlaybackSeekSlider_KeyUp"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"><Run Text="{Binding PositionText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding DurationText, Mode=OneWay}"/></TextBlock>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="8"/><ColumnDefinition Width="54"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PrimaryButtonStyle}" FontSize="17" Content="{Binding StatusText, Mode=OneWay, Converter={StaticResource PlaybackStatusIconConverter}}" ToolTip="再生 / 一時停止" Click="PlaybackPlayPause_Click"/>
                            <Button Grid.Column="2" FontSize="15" Content="■" ToolTip="停止" Click="PlaybackStop_Click"/>
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="再生モード"/>
                            <ComboBox Grid.Column="6" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Value, Converter={StaticResource PlaybackModeLabelConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="82"/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="82"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="同期オフセット" ToolTip="Aを基準にしたBの相対開始位置です。"/>
                            <Button Grid.Column="2" Padding="10,5" Content="−10 ms" Click="RelativeOffsetMinus_Click"/>
                            <Border Grid.Column="4" Padding="8,5" Background="#F3F6F9" CornerRadius="4">
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold"><TextBlock.Text><MultiBinding Converter="{StaticResource RelativeOffsetConverter}"><Binding Path="OffsetASeconds" Mode="OneWay"/><Binding Path="OffsetBSeconds" Mode="OneWay"/></MultiBinding></TextBlock.Text></TextBlock>
                            </Border>
                            <Button Grid.Column="6" Padding="10,5" Content="+10 ms" Click="RelativeOffsetPlus_Click"/>
                            <Button Grid.Column="8" Content="解析値に戻す" Click="ResetOffset_Click"/>
                            <TextBlock Grid.Column="10" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="＋の値はBを遅らせます（Aを基準）"/>
                        </Grid>
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="54"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="A 音量"/>
                            <Slider Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="10" Value="{Binding VolumeAPercent, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding VolumeAPercent, Mode=OneWay, StringFormat={}{0:F0}%}"/>
                            <TextBlock Grid.Column="6" VerticalAlignment="Center" FontWeight="SemiBold" Text="B 音量"/>
                            <Slider Grid.Column="8" Minimum="0" Maximum="100" TickFrequency="10" Value="{Binding VolumeBPercent, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="10" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding VolumeBPercent, Mode=OneWay, StringFormat={}{0:F0}%}"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ReviewButtonStyle}" Content="重複ではない" IsEnabled="{Binding DataContext.CanReview, RelativeSource={RelativeSource AncestorType=Window}}" Click="NotDuplicate_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource ReviewButtonStyle}" Content="重複 / Aを残す" IsEnabled="{Binding DataContext.CanReview, RelativeSource={RelativeSource AncestorType=Window}}" Click="KeepA_Click"/>
                    <Button Grid.Column="4" Style="{StaticResource ReviewButtonStyle}" Content="重複 / Bを残す" IsEnabled="{Binding DataContext.CanReview, RelativeSource={RelativeSource AncestorType=Window}}" Click="KeepB_Click"/>
                    <Button Grid.Column="6" Content="..." ToolTip="その他の操作" IsEnabled="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" Click="CandidateMore_Click"/>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding StatusText, Mode=OneWay}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding AnalysisStatusText, Mode=OneWay}"/>
                <TextBlock Grid.Column="3" VerticalAlignment="Center"><Run Text="{Binding TrashStatusText, Mode=OneWay}"/><Run Text="   再生: "/><Run Text="{Binding Playback.StatusText, Mode=OneWay}"/></TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
