<Window x:Class="TrackMatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:playback="clr-namespace:TrackMatch.App.Playback"
        Title="TrackMatch"
        Width="1480"
        Height="1040"
        MinWidth="1180"
        MinHeight="860">
    <Window.Resources>
        <playback:PlaybackModeLabelConverter x:Key="PlaybackModeLabelConverter" />
        <playback:RelativeOffsetConverter x:Key="RelativeOffsetConverter" />
        <playback:PlaybackStatusIconConverter x:Key="PlaybackStatusIconConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="0" />
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="0" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="ライブラリ" />
            <ComboBox x:Name="LibraryComboBox"
                      Grid.Column="2"
                      DisplayMemberPath="Name"
                      IsEnabled="{Binding CanManageLibraries}"
                      ItemsSource="{Binding Libraries}"
                      SelectedItem="{Binding SelectedLibrary}"
                      SelectionChanged="LibraryComboBox_SelectionChanged" />
            <Button Grid.Column="4"
                    Click="ManageLibraries_Click"
                    IsEnabled="{Binding CanManageLibraries}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14"
                             Height="14"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center">
                        <Canvas Width="24"
                                Height="24">
                            <Path Data="M10,2 L14,2 L14.6,5.1 L16.1,5.7 L18.7,3.9 L21.1,6.3 L19.3,8.9 L19.9,10.4 L23,11 L23,13 L19.9,13.6 L19.3,15.1 L21.1,17.7 L18.7,20.1 L16.1,18.3 L14.6,18.9 L14,22 L10,22 L9.4,18.9 L7.9,18.3 L5.3,20.1 L2.9,17.7 L4.7,15.1 L4.1,13.6 L1,13 L1,11 L4.1,10.4 L4.7,8.9 L2.9,6.3 L5.3,3.9 L7.9,5.7 L9.4,5.1 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeLineJoin="Miter"
                                  StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="8.5"
                                     Canvas.Top="8.5"
                                     Width="7"
                                     Height="7"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.5" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center"
                               Text="設定..." />
                </StackPanel>
            </Button>
            <Button Grid.Column="6"
                    Click="AnalyzeLibrary_Click"
                    Content="⌕  スキャン・分析"
                    IsEnabled="{Binding CanAnalyzeLibrary}"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Grid.Column="8"
                    Click="CancelAnalysis_Click"
                    Content="■  キャンセル"
                    IsEnabled="{Binding CanCancelAnalysis}" />
            <Button Grid.Column="10"
                    Click="ExecuteTrash_Click"
                    Content="ごみ箱へ移動"
                    IsEnabled="{Binding CanProcessTrash}" />
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Padding="0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="12,12,12,6"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="候補一覧" />
                    <TabControl x:Name="CandidateTabs"
                                Grid.Row="1"
                                Height="40"
                                Margin="8,0,8,0"
                                SelectionChanged="CandidateTabs_SelectionChanged">
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock><Run Text="未レビュー (" /><Run Text="{Binding UnreviewedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock><Run Text="レビュー済み (" /><Run Text="{Binding ReviewedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock><Run Text="再確認推奨 (" /><Run Text="{Binding ReReviewRecommendedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock><Run Text="すべて (" /><Run Text="{Binding TotalCandidateCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                            </TabItem.Header>
                        </TabItem>
                    </TabControl>
                    <Grid Grid.Row="2"
                          Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,8,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="レビュー対象の一致度下限" />
                        <TextBox Grid.Column="1"
                                 Width="48"
                                 HorizontalContentAlignment="Right"
                                 Text="{Binding SimilarityDisplayLowerBoundPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Text="%" />
                    </Grid>
                    <Grid Grid.Row="3">
                        <DataGrid x:Name="CandidateGrid"
                                  Margin="0,0,1,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Candidates}"
                                  SelectedItem="{Binding SelectedCandidate}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Resources>
                                <Style BasedOn="{StaticResource AppScrollBarStyle}"
                                       TargetType="ScrollBar">
                                    <Setter Property="Background" Value="White" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="95"
                                                    Binding="{Binding Kind}"
                                                    Header="分類" />
                                <DataGridTextColumn Width="*"
                                                    MinWidth="100"
                                                    Binding="{Binding TitleA}"
                                                    Header="A" />
                                <DataGridTextColumn Width="*"
                                                    MinWidth="100"
                                                    Binding="{Binding TitleB}"
                                                    Header="B" />
                                <DataGridTextColumn Width="70"
                                                    Binding="{Binding Similarity}"
                                                    Header="一致度" />
                                <DataGridTextColumn Width="135"
                                                    Binding="{Binding ReviewResult}"
                                                    Header="レビュー結果" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="CandidateGridHeaderCornerOverlay"
                                Width="14"
                                Height="29"
                                Margin="0,1,1,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#F3F6F9"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,1,0"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="CandidateGridHeaderCornerBottomBorder"
                                Width="14"
                                Height="1"
                                Margin="0,29,1,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource BorderBrush}"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="CandidateGridRightEdgeOverlay"
                                Width="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Background="{StaticResource BorderBrush}"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="2"
                  DataContext="{Binding SelectedCandidate}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Padding="10"
                              Header="音源 A">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding TitleA}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ArtistA}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding AlbumA}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding GenreA}"
                                           TextWrapping="Wrap" />
                                <Separator Margin="0,8" />
                                <TextBlock Text="{Binding DurationA, StringFormat=再生時間: {0}}" />
                                <TextBlock Text="{Binding FormatCodecA, StringFormat=形式 / コーデック: {0}}" />
                                <TextBlock Text="{Binding FileSizeA, StringFormat=ファイルサイズ: {0}}" />
                                <TextBlock Text="{Binding BitrateA, StringFormat=ビットレート: {0}}" />
                                <TextBlock Text="{Binding SampleRateA, StringFormat=サンプルレート: {0}}" />
                                <TextBlock Text="{Binding BitDepthA, StringFormat=ビット深度: {0}}" />
                                <TextBlock Text="{Binding ChannelsA, StringFormat=チャンネル数: {0}}" />
                                <TextBlock Margin="0,8,0,0"
                                           Opacity="0.7"
                                           Text="{Binding Row.PathA}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                    <GroupBox Grid.Column="2"
                              Padding="10"
                              Header="音源 B">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding TitleB}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ArtistB}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding AlbumB}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding GenreB}"
                                           TextWrapping="Wrap" />
                                <Separator Margin="0,8" />
                                <TextBlock Text="{Binding DurationB, StringFormat=再生時間: {0}}" />
                                <TextBlock Text="{Binding FormatCodecB, StringFormat=形式 / コーデック: {0}}" />
                                <TextBlock Text="{Binding FileSizeB, StringFormat=ファイルサイズ: {0}}" />
                                <TextBlock Text="{Binding BitrateB, StringFormat=ビットレート: {0}}" />
                                <TextBlock Text="{Binding SampleRateB, StringFormat=サンプルレート: {0}}" />
                                <TextBlock Text="{Binding BitDepthB, StringFormat=ビット深度: {0}}" />
                                <TextBlock Text="{Binding ChannelsB, StringFormat=チャンネル数: {0}}" />
                                <TextBlock Margin="0,8,0,0"
                                           Opacity="0.7"
                                           Text="{Binding Row.PathB}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
                <Border Grid.Row="2"
                        Padding="10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDuplicateGroups}"
                                             Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ItemsControl ItemsSource="{Binding DuplicateGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="18"
                                               Text="♟" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Header}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="{StaticResource AccentBrush}"
                                                       Text="{Binding KeepSummary}" />
                                            <TextBlock Margin="12,0,0,0"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       Text="{Binding OtherFilesText}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="3"
                                            Padding="14,6"
                                            Click="ShowDuplicateGroupDetails_Click"
                                            Content="グループの詳細を表示..."
                                            Tag="{Binding Id}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Padding="10"
                              Header="比較結果">
                        <StackPanel>
                            <Border Padding="12,10"
                                    Background="#F3F7FB"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="音響一致度" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding Similarity}" />
                                </Grid>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                           Text="Aの一致範囲" />
                                <TextBlock Grid.Column="1"
                                           FontWeight="SemiBold"
                                           Text="{Binding CoverageA}" />
                                <TextBlock Grid.Row="1"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="Bの一致範囲" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           FontWeight="SemiBold"
                                           Text="{Binding CoverageB}" />
                                <TextBlock Grid.Row="2"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="再生時間の近さ" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           FontWeight="SemiBold"
                                           Text="{Binding DurationRatio}" />
                                <TextBlock Grid.Row="3"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="最適オフセット" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           FontWeight="SemiBold"
                                           Text="{Binding BestOffset}" />
                                <TextBlock Grid.Row="4"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="一致区間の長さ" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           FontWeight="SemiBold"
                                           Text="{Binding MatchedDuration}" />
                            </Grid>
                            <Border Margin="0,10,0,0"
                                    Padding="10,8"
                                    Background="#F7F8FA"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                               Text="判定理由" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding Reason}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="{Binding ReviewOriginText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="2"
                              Padding="10"
                              Header="音質比較">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding QualityStatusText}" />
                                <Button Grid.Column="1"
                                        Click="ReanalyzeQuality_Click"
                                        Content="音質を再解析"
                                        IsEnabled="{Binding CanReanalyzeQuality}" />
                            </Grid>
                            <ContentControl Grid.Row="2"
                                            Content="{Binding QualityPanel}" />
                        </Grid>
                    </GroupBox>
                </Grid>
                <GroupBox Grid.Row="6"
                          Padding="10"
                          DataContext="{Binding DataContext.Playback, RelativeSource={RelativeSource AncestorType=Window}}"
                          Header="A/B 同期再生">
                    <Grid IsEnabled="{Binding CanControl}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="PlaybackSeekSlider"
                                    KeyUp="PlaybackSeekSlider_KeyUp"
                                    Maximum="{Binding DurationSeconds}"
                                    Minimum="0"
                                    PreviewMouseLeftButtonUp="PlaybackSeekSlider_PreviewMouseLeftButtonUp"
                                    Value="{Binding PositionSeconds, Mode=OneWay}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"><Run Text="{Binding PositionText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding DurationText, Mode=OneWay}" /></TextBlock>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Click="PlaybackPlayPause_Click"
                                    Content="{Binding StatusText, Mode=OneWay, Converter={StaticResource PlaybackStatusIconConverter}}"
                                    FontSize="17"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="再生 / 一時停止" />
                            <Button Grid.Column="2"
                                    Click="PlaybackStop_Click"
                                    Content="■"
                                    FontSize="15"
                                    ToolTip="停止" />
                            <TextBlock Grid.Column="4"
                                       VerticalAlignment="Center"
                                       Text="再生モード" />
                            <ComboBox Grid.Column="6"
                                      ItemsSource="{Binding Modes}"
                                      SelectedItem="{Binding SelectedMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value, Converter={StaticResource PlaybackModeLabelConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="同期オフセット"
                                       ToolTip="Aを基準にしたBの相対開始位置です。" />
                            <Button Grid.Column="2"
                                    Padding="10,5"
                                    Click="RelativeOffsetMinus_Click"
                                    Content="−10 ms" />
                            <Border Grid.Column="4"
                                    Padding="8,5"
                                    Background="#F3F6F9"
                                    CornerRadius="4">
                                <TextBlock HorizontalAlignment="Center"
                                           FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource RelativeOffsetConverter}">
                                            <Binding Mode="OneWay"
                                                     Path="OffsetASeconds" />
                                            <Binding Mode="OneWay"
                                                     Path="OffsetBSeconds" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                            <Button Grid.Column="6"
                                    Padding="10,5"
                                    Click="RelativeOffsetPlus_Click"
                                    Content="+10 ms" />
                            <Button Grid.Column="8"
                                    Click="ResetOffset_Click"
                                    Content="解析値に戻す" />
                            <TextBlock Grid.Column="10"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="＋の値はBを遅らせます（Aを基準）" />
                        </Grid>
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="54" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="A 音量" />
                            <Slider Grid.Column="2"
                                    Maximum="100"
                                    Minimum="0"
                                    TickFrequency="10"
                                    Value="{Binding VolumeAPercent, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="4"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="{Binding VolumeAPercent, Mode=OneWay, StringFormat={}{0:F0}%}" />
                            <TextBlock Grid.Column="6"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="B 音量" />
                            <Slider Grid.Column="8"
                                    Maximum="100"
                                    Minimum="0"
                                    TickFrequency="10"
                                    Value="{Binding VolumeBPercent, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="{Binding VolumeBPercent, Mode=OneWay, StringFormat={}{0:F0}%}" />
                        </Grid>
                    </Grid>
                </GroupBox>
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Button Click="NotDuplicate_Click"
                            Content="重複ではない"
                            IsEnabled="{Binding DataContext.CanReview, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource ReviewButtonStyle}" />
                    <Button Grid.Column="2"
                            Click="KeepA_Click"
                            Content="重複 / Aを残す"
                            IsEnabled="{Binding DataContext.CanReview, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource ReviewButtonStyle}" />
                    <Button Grid.Column="4"
                            Click="KeepB_Click"
                            Content="重複 / Bを残す"
                            IsEnabled="{Binding DataContext.CanReview, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource ReviewButtonStyle}" />
                    <Button Grid.Column="6"
                            Click="CandidateMore_Click"
                            Content="..."
                            IsEnabled="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="その他の操作" />
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="8"
                Padding="0,10,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding StatusText, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding AnalysisStatusText, Mode=OneWay}" />
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"><Run Text="{Binding TrashStatusText, Mode=OneWay}" /><Run Text="   再生: " /><Run Text="{Binding Playback.StatusText, Mode=OneWay}" /></TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
