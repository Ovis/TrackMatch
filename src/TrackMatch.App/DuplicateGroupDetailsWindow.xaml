<Window x:Class="TrackMatch.App.DuplicateGroupDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重複グループ" Height="720" Width="820" MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding GroupTitle}"/>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{Binding FileCountText}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="残すファイル"/>
                <ItemsControl ItemsSource="{Binding KeepTracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="#F3F7FB">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="★ "/><Run Text="{Binding Title}"/></TextBlock>
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Artist}"/>
                                        <TextBlock Margin="0,2,0,0" Text="{Binding Album}" Style="{StaticResource SecondaryTextStyle}"/>
                                        <TextBlock Margin="0,5,0,0" Text="{Binding MetadataSummary}"/>
                                        <TextBlock Margin="0,2,0,0" Text="{Binding Duration, StringFormat=再生時間: {0}}" Style="{StaticResource SecondaryTextStyle}"/>
                                        <TextBlock Margin="0,5,0,0" Text="{Binding Path}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Bottom" Orientation="Horizontal">
                                        <Button Margin="0,0,8,0" Padding="12,6" Content="▶ 再生" Tag="{Binding Path}" Click="Preview_Click"/>
                                        <Button Padding="12,6" Content="📁" ToolTip="エクスプローラーで表示" Tag="{Binding Path}" Click="OpenFolder_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,20,0,8" FontWeight="SemiBold" Text="重複として確認済み"/>
                <ItemsControl ItemsSource="{Binding OtherTracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}"/>
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Artist}"/>
                                        <TextBlock Margin="0,2,0,0" Text="{Binding Album}" Style="{StaticResource SecondaryTextStyle}"/>
                                        <TextBlock Margin="0,5,0,0" Text="{Binding MetadataSummary}"/>
                                        <TextBlock Margin="0,2,0,0" Text="{Binding Duration, StringFormat=再生時間: {0}}" Style="{StaticResource SecondaryTextStyle}"/>
                                        <TextBlock Margin="0,5,0,0" Text="{Binding Path}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Bottom" Orientation="Horizontal">
                                        <Button Margin="0,0,8,0" Padding="12,6" Content="▶ 再生" Tag="{Binding Path}" Click="Preview_Click"/>
                                        <Button Padding="12,6" Content="📁" ToolTip="エクスプローラーで表示" Tag="{Binding Path}" Click="OpenFolder_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Margin="0,12,0,0" Header="確認済みの重複関係">
                    <ItemsControl Margin="12,8,0,0" ItemsSource="{Binding ConfirmedRelations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Margin="0,2" Text="{Binding}"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="4" Width="100" HorizontalAlignment="Right" Content="閉じる" IsCancel="True" Click="Close_Click"/>
    </Grid>
</Window>
