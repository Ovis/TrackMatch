<Window x:Class="TrackMatch.App.DuplicateGroupDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重複グループ" Height="760" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding GroupTitle}"/>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{Binding FileCountText}"/>
            </StackPanel>
            <Border Grid.Column="1" Padding="10,5" CornerRadius="12" Background="#EEF5FD" VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="Global Duplicate Group"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Margin="12,12,12,8" Style="{StaticResource SectionTitleStyle}" Text="グループ内Track"/>
                    <DataGrid x:Name="TrackGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding AllTracks}"
                              SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="状態" Binding="{Binding DispositionLabel}" Width="72"/>
                            <DataGridTextColumn Header="Library" Binding="{Binding ScopeLabel}" Width="105"/>
                            <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="長さ" Binding="{Binding Duration}" Width="70"/>
                            <DataGridTextColumn Header="情報" Binding="{Binding MetadataSummary}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Padding="12,9" Background="#F7F8FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Library外TrackもGlobal Groupの文脈として表示します。物理ファイル操作は明示的に選択したTrackだけが対象です。" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14" DataContext="{Binding SelectedTrack}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,3,0,0" Text="{Binding Artist}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{Binding Album}" TextWrapping="Wrap"/>
                            <Border Margin="0,8,0,0" Padding="8,3" CornerRadius="10" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EEF5FD"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInCurrentLibrary}" Value="False">
                                                <Setter Property="Background" Value="#FFF1D9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="SemiBold" Text="{Binding ScopeLabel}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInCurrentLibrary}" Value="False">
                                                    <Setter Property="Foreground" Value="#A05A00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1" Width="32" Height="30" MinWidth="32" MinHeight="30" Padding="0"
                                ToolTip="フォルダーを開く" Tag="{Binding Path}" Click="OpenFolder_Click">
                            <Viewbox Width="18" Height="16">
                                <Canvas Width="18" Height="16">
                                    <Path Data="M2,13 L4.5,6 L16,6 L13.5,13 Z M2,13 L2,4 L7,4 L9,6"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <TabControl Grid.Row="2">
                        <TabItem Header="基本情報">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="{Binding MetadataSummary}" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding Duration, StringFormat=再生時間: {0}}"/>
                                    <Separator Margin="0,10"/>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="ファイルパス"/>
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Path}" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}" Text="Track ID"/>
                                    <TextBlock Margin="0,4,0,0" Text="{Binding TrackId}"/>
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}" Text="Missing"/>
                                    <TextBlock Margin="0,4,0,0" Text="{Binding IsMissing}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="確認済み関係">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl Margin="10" ItemsSource="{Binding DataContext.ConfirmedRelations, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Margin="0,3" Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="4" Padding="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviewButton" Width="82" Padding="10,6" Content="▶ 再生" Tag="{Binding Path}" Click="Preview_Click"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="簡易試聴"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Padding="14,7" Content="このファイルを残す" IsEnabled="{Binding SelectedTrack.CanSelectAsKeep}" Click="SetSelectedKeep_Click"/>
                <Button Margin="8,0,0,0" Padding="14,7" Content="ごみ箱へ移動..." IsEnabled="{Binding SelectedTrack.CanTrashGlobally}" Click="TrashSelectedTrack_Click"/>
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{Binding KeepStateText}"/>
            </StackPanel>
            <Button Grid.Column="1" Width="100" Content="閉じる" IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
