<Window x:Class="TrackMatch.App.LibraryManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ライブラリ管理" Width="900" Height="600" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ListBox x:Name="LibrariesListBox" DisplayMemberPath="Name" SelectionChanged="LibrariesListBox_SelectionChanged"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Width="100" Height="30" Content="+ 新規" Click="NewLibrary_Click"/>
                <Button Width="100" Height="30" Margin="8,0,0,0" Content="削除" Click="DeleteLibrary_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                <RowDefinition Height="*"/><RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="ライブラリを選択"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="名前"/>
                <TextBox x:Name="NameTextBox" Grid.Column="2" Height="30" VerticalContentAlignment="Center" TextChanged="NameTextBox_TextChanged"/>
                <Button Grid.Column="4" Height="30" Content="保存" Click="SaveName_Click"/>
            </Grid>
            <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="対象フォルダ"/>
            <ListBox x:Name="RootsListBox" Grid.Row="6" DisplayMemberPath="Path"/>
            <StackPanel Grid.Row="8" Orientation="Horizontal">
                <Button Width="90" Height="30" Content="追加..." Click="AddRoot_Click"/>
                <Button Width="140" Height="30" Margin="8,0,0,0" Content="保存場所を変更..." Click="RemapRoot_Click"/>
                <Button Width="90" Height="30" Margin="8,0,0,0" Content="削除" Click="DeleteRoot_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Row="10" TextWrapping="Wrap"/>
        </Grid>
        <Button Grid.Row="2" Grid.Column="2" Width="100" Height="32" HorizontalAlignment="Right" Content="閉じる" IsDefault="True" Click="Close_Click"/>
    </Grid>
</Window>
