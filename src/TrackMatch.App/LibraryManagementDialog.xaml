<Window x:Class="TrackMatch.App.LibraryManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ライブラリ管理"
        Width="940"
        Height="650"
        MinWidth="800"
        MinHeight="540"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="LibrariesListBox"
                         DisplayMemberPath="Name"
                         SelectionChanged="LibrariesListBox_SelectionChanged" />
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal">
                    <Button Width="100"
                            Click="NewLibrary_Click"
                            Content="＋ 新規" />
                    <Button Width="100"
                            Margin="8,0,0,0"
                            Click="DeleteLibrary_Click"
                            Content="削除" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Column="2"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionTitleStyle}"
                           Text="ライブラリを選択" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="名前" />
                    <TextBox x:Name="NameTextBox"
                             Grid.Column="2"
                             TextChanged="NameTextBox_TextChanged" />
                    <Button Grid.Column="4"
                            Click="SaveName_Click"
                            Content="保存" />
                </Grid>
                <TextBlock Grid.Row="4"
                           FontWeight="SemiBold"
                           Text="対象フォルダ" />
                <ListBox x:Name="RootsListBox"
                         Grid.Row="6"
                         DisplayMemberPath="Path" />
                <StackPanel Grid.Row="8"
                            Orientation="Horizontal">
                    <Button Width="90"
                            Click="AddRoot_Click"
                            Content="追加..." />
                    <Button Width="140"
                            Margin="8,0,0,0"
                            Click="RemapRoot_Click"
                            Content="保存場所を変更..." />
                    <Button Width="90"
                            Margin="8,0,0,0"
                            Click="DeleteRoot_Click"
                            Content="削除" />
                </StackPanel>
                <TextBlock Grid.Row="10"
                           FontWeight="SemiBold"
                           Text="レビュー済み重複音源のごみ箱" />
                <Grid Grid.Row="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TrashRootTextBox"
                             IsReadOnly="True" />
                    <Button Grid.Column="2"
                            Click="BrowseTrashRoot_Click"
                            Content="参照..." />
                </Grid>
                <TextBlock x:Name="StatusText"
                           Grid.Row="14"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Grid Grid.Row="2"
              Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Width="120"
                    Click="ManageTracks_Click"
                    Content="音源管理..." />
            <Button Grid.Column="2"
                    Width="100"
                    Click="Close_Click"
                    Content="閉じる"
                    IsDefault="True" />
        </Grid>
    </Grid>
</Window>
