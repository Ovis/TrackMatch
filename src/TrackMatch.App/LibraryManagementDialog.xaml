<Window x:Class="TrackMatch.App.LibraryManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ライブラリ管理" Width="940" Height="650" MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="LibrariesListBox" DisplayMemberPath="Name" SelectionChanged="LibrariesListBox_SelectionChanged"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Width="100" Content="＋ 新規" Click="NewLibrary_Click"/>
                    <Button Width="100" Margin="8,0,0,0" Content="削除" Click="DeleteLibrary_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="ライブラリを選択"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="名前"/>
                    <TextBox x:Name="NameTextBox" Grid.Column="2" TextChanged="NameTextBox_TextChanged"/>
                    <Button Grid.Column="4" Content="保存" Click="SaveName_Click"/>
                </Grid>
                <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="対象フォルダ"/>
                <ListBox x:Name="RootsListBox" Grid.Row="6" DisplayMemberPath="Path"/>
                <StackPanel Grid.Row="8" Orientation="Horizontal">
                    <Button Width="90" Content="追加..." Click="AddRoot_Click"/>
                    <Button Width="140" Margin="8,0,0,0" Content="保存場所を変更..." Click="RemapRoot_Click"/>
                    <Button Width="90" Margin="8,0,0,0" Content="削除" Click="DeleteRoot_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="10" FontWeight="SemiBold" Text="レビュー済み重複音源のごみ箱"/>
                <Grid Grid.Row="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TrashRootTextBox" IsReadOnly="True"/>
                    <Button Grid.Column="2" Content="参照..." Click="BrowseTrashRoot_Click"/>
                </Grid>
                <TextBlock x:Name="StatusText" Grid.Row="14" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"/>
            </Grid>
        </Border>
        <Button Grid.Row="2" Grid.Column="2" Width="100" HorizontalAlignment="Right" Content="閉じる" IsDefault="True" Click="Close_Click"/>
    </Grid>
</Window>
