<Window x:Class="TrackMatch.App.NewLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Libraryを作成" Width="620" Height="430" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Library名" />
        <TextBox x:Name="NameTextBox" Grid.Row="2" Height="30" VerticalContentAlignment="Center" />
        <GroupBox Grid.Row="4" Header="Root folders" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="RootsListBox" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="90" Height="28" Content="追加..." Click="AddRoot_Click" />
                    <Button Width="90" Height="28" Margin="8,0,0,0" Content="削除" Click="RemoveRoot_Click" />
                </StackPanel>
            </Grid>
        </GroupBox>
        <TextBlock x:Name="ErrorText" Grid.Row="6" Foreground="DarkRed" TextWrapping="Wrap" />
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Height="32" Content="作成" IsDefault="True" Click="Create_Click" />
            <Button Width="100" Height="32" Margin="8,0,0,0" Content="キャンセル" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
